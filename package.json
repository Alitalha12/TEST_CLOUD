{
  "name": "anonymous-campus",
  "version": "0.0.0",
  "private": true,
  "description": "Anonymous university social & chat platform — monorepo root",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @campus/server run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "pnpm run build:shared",
    "typecheck": "pnpm -r --if-present run typecheck",
    "pretest": "pnpm run build:shared",
    "test": "pnpm -r --if-present run test",
    "build:shared": "pnpm --filter @campus/shared run build",
    "db:generate": "pnpm --filter @campus/database run prisma:generate",
    "db:migrate": "pnpm --filter @campus/database run prisma:migrate",
    "db:deploy": "pnpm --filter @campus/database run prisma:deploy",
    "db:seed": "pnpm --filter @campus/database run prisma:seed",
    "db:studio": "pnpm --filter @campus/database run prisma:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@campus/config": "workspace:*",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "react-native-worklets": "0.10.4",
      "@react-native/metro-config": "0.86.3"
    }
  }
}
