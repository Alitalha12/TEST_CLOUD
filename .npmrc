# React Native / Expo's Metro bundler expects a flat, hoisted node_modules
# layout (it doesn't resolve pnpm's default symlinked/isolated structure
# without extra config). Hoisted linking avoids that friction for the whole
# workspace. Re-verify this against the current Expo monorepo guide before
# apps/mobile is scaffolded in Phase 2 — Expo's recommended pnpm setup has
# changed between SDK versions.
node-linker=hoisted

# Keep lockfile deterministic across the team's machines.
strict-peer-dependencies=false
auto-install-peers=true
