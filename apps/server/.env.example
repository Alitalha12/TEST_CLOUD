# Server env schema: apps/server/src/config/env.js (Zod-validated; the
# process refuses to start if a required value is missing/invalid).
# Copy this file to apps/server/.env for local development — .env itself
# is git-ignored and must never be committed.

NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"

DATABASE_URL="postgresql://campus:campus@localhost:5432/campus_dev"
REDIS_URL="redis://localhost:6379"

# Comma-separated allow-list for CORS. Empty by default — the mobile app
# sends no Origin header, so this only matters for browser clients (the
# admin app, from Phase 10). NEVER "*". Example once the admin exists:
# CORS_ALLOWED_ORIGINS="http://localhost:3001"
CORS_ALLOWED_ORIGINS=""

# Used only by tests (tests/setup/testEnv.js) — a separate database so
# test runs never touch campus_dev's data. Created automatically by
# `pnpm --filter @campus/server test` via scripts/prepare-test-db.mjs.
TEST_DATABASE_URL="postgresql://campus:campus@localhost:5432/campus_test"

# Same reasoning, for Redis (Phase 3+): a different numbered DB (1) on
# the same Redis server, so rate-limit counters and cached auth state
# from test runs never mix with a running `pnpm dev` server's.
TEST_REDIS_URL="redis://localhost:6379/1"

# S3-compatible storage, standing in for Cloudflare R2 locally
# (adobe/s3mock — see docs/adr/0009-s3mock-instead-of-minio-locally.md).
# s3mock doesn't check credentials, but the AWS SDK still requires some
# values to be present, so these are dummy but must be non-empty.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="campus-media-dev"
S3_ACCESS_KEY_ID="local"
S3_SECRET_ACCESS_KEY="local"
S3_FORCE_PATH_STYLE="true"

# Mailpit (fake SMTP for local OTP email testing).
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="Anonymous Campus <no-reply@localhost>"

# --- Phase 3: auth secrets (docs/architecture.md §11) ---
# Generate real local values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# for EMAIL_HASH_PEPPER and JWT_ACCESS_SECRET, and:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# for EMAIL_ENC_KEY (must decode to exactly 32 bytes). NEVER reuse these
# example placeholders anywhere real — they are not secrets, they're the
# opposite of secrets.
EMAIL_HASH_PEPPER="replace-with-a-random-32-plus-character-value"
EMAIL_ENC_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
JWT_ACCESS_SECRET="replace-with-a-random-32-plus-character-value"
JWT_KID="dev-key-1"

# Enforced by the minAppVersion middleware. A request with an
# X-App-Version below MIN_APP_VERSION gets 426 UPGRADE_REQUIRED.
MIN_APP_VERSION="1.0.0"
LATEST_APP_VERSION="1.0.0"
