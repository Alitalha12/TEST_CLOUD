{
  "name": "@campus/server",
  "version": "0.0.0",
  "private": true,
  "description": "Node.js/Express API + Socket.IO + BullMQ worker (docs/architecture.md §7)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env --watch src/worker.js",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "pretest": "pnpm --filter @campus/database run prepare-test-db",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@campus/database": "workspace:*",
    "@campus/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "cors": "^2.8.6",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@campus/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^7.0.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
