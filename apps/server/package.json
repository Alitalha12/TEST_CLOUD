{
  "name": "@campus/server",
  "version": "0.0.0",
  "private": true,
  "description": "Node.js/Express API + Socket.IO + BullMQ worker (docs/architecture.md §7)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "pretest": "node --env-file-if-exists=.env scripts/prepare-test-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "node scripts/run-with-env.mjs pnpm exec prisma generate",
    "prisma:migrate": "node scripts/run-with-env.mjs pnpm exec prisma migrate dev",
    "prisma:deploy": "node scripts/run-with-env.mjs pnpm exec prisma migrate deploy",
    "prisma:seed": "node scripts/run-with-env.mjs pnpm exec prisma db seed",
    "prisma:studio": "node scripts/run-with-env.mjs pnpm exec prisma studio"
  },
  "dependencies": {
    "@campus/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@campus/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
