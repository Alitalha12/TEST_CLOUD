// Phase 1: tenancy + meta lookup tables. Phase 3 adds users/auth
// (docs/architecture.md §8.3 "users", "user_identities",
// "verification_challenges", "sessions", "banned_email_hashes",
// "user_settings"). Phase 4 adds the persona tables ("anonymous_profiles",
// "profile_name_history", "profile_interests"). Do NOT add any content
// table (posts/comments/chat/safety/...) here — those arrive in Phase 5+.
//
// Connection config moved out of this file in Prisma 7 — see
// ../prisma.config.js and docs/adr/0010-prisma-7-driver-adapter.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UniversityStatus {
  ACTIVE
  PILOT
  DISABLED

  @@map("university_status")
}

model University {
  id        String           @id @default(uuid(7))
  slug      String           @unique
  name      String
  status    UniversityStatus @default(PILOT)
  settings  Json             @default("{}")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  domains     UniversityDomain[]
  departments Department[]
  users       User[]
  profiles    AnonymousProfile[]

  @@map("universities")
}

model UniversityDomain {
  id           String   @id @default(uuid(7))
  universityId String   @map("university_id")
  domain       String   @unique
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  @@index([universityId])
  @@map("university_domains")
}

model Department {
  id           String   @id @default(uuid(7))
  universityId String   @map("university_id")
  name         String
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  university University         @relation(fields: [universityId], references: [id], onDelete: Restrict)
  profiles   AnonymousProfile[]

  @@unique([universityId, name])
  @@index([universityId, sortOrder])
  @@map("departments")
}

model Interest {
  id        String   @id @default(uuid(7))
  slug      String   @unique
  name      String
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profiles ProfileInterest[]

  @@index([isActive])
  @@map("interests")
}

// --- Phase 3: auth (docs/architecture.md §11, §28 P3) ---
//
// D8: no real_name/phone/student-ID columns anywhere below — only an
// encrypted email plus an HMAC hash of it. Data never collected can't leak.

/**
 * Mirrors packages/shared/src/enums.js AccountStatus (§8.3 `users.status`).
 */
enum AccountStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  BANNED
  PENDING_DELETION
  DELETED

  @@map("account_status")
}

/**
 * Mirrors packages/shared/src/enums.js Platform.
 */
enum Platform {
  ANDROID
  IOS

  @@map("platform")
}

/**
 * Mirrors packages/shared/src/enums.js PushPreview (§8.3 `user_settings.push_preview`).
 */
enum PushPreview {
  NONE
  SENDER_ONLY

  @@map("push_preview")
}

/**
 * The account row itself. **Never serialized** — `id` never leaves the
 * server except inside the user's own JWT (§8.3 `users` privacy column).
 * `role` and a verification challenge's `purpose` are plain strings, not
 * enums, because each currently has exactly one real value ("USER",
 * "LOGIN") reserved for future expansion — see §8.3's backtick-quoted
 * single values.
 */
model User {
  id              String        @id @default(uuid(7))
  universityId    String        @map("university_id")
  emailHash       String        @unique @map("email_hash")
  status          AccountStatus @default(ACTIVE)
  role            String        @default("USER")
  restrictedUntil DateTime?     @map("restricted_until")
  suspendedUntil  DateTime?     @map("suspended_until")
  onboardedAt     DateTime?     @map("onboarded_at")
  lastActiveAt    DateTime?     @map("last_active_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  university University        @relation(fields: [universityId], references: [id], onDelete: Restrict)
  identity   UserIdentity?
  sessions   Session[]
  settings   UserSetting?
  profile    AnonymousProfile?

  @@index([universityId, status])
  @@map("users")
}

/**
 * The only place a real email lives. **Highly restricted**: read only by
 * the auth module and (later) a break-glass admin flow (§8.3 privacy
 * column, §11.4). `emailDomain` is stored in the clear specifically so it
 * can be read/indexed without decrypting the full address.
 */
model UserIdentity {
  userId          String   @id @map("user_id")
  emailEncrypted  String   @map("email_encrypted")
  emailKeyVersion Int      @map("email_key_version")
  emailDomain     String   @map("email_domain")
  verifiedAt      DateTime @map("verified_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_identities")
}

/**
 * One row per `otp/request` call. Internal only; purged after 24h by a
 * later-phase cleanup job (§8.3). Not linked to `users` by FK — a
 * challenge can exist for an email that has no account yet (first login
 * = signup, §11.2).
 */
model VerificationChallenge {
  id          String    @id @default(uuid(7))
  emailHash   String    @map("email_hash")
  codeHash    String    @map("code_hash")
  purpose     String    @default("LOGIN")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  ipHash      String    @map("ip_hash")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([emailHash, createdAt(sort: Desc)])
  @@map("verification_challenges")
}

/**
 * A refresh-token family (§11.3). `refreshTokenHash` is a SHA-256 hash of
 * the opaque 256-bit token the client holds — the plaintext token is
 * never stored. `familyId` is shared across every token in a rotation
 * chain, so reuse of an already-rotated token can revoke the whole chain.
 */
model Session {
  id               String    @id @default(uuid(7))
  userId           String    @map("user_id")
  familyId         String    @map("family_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  platform         Platform
  deviceLabel      String    @map("device_label")
  appVersion       String    @map("app_version")
  ipHash           String    @map("ip_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason")
  replacedById     String?   @map("replaced_by_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

/**
 * Enforces a ban even after the account behind it is deleted (§8.3,
 * §11.7 "Deletion": "Delete `user_identities` **unless** the user was
 * banned (then keep `banned_email_hashes` only)"). Never linked by FK to
 * `users` — it must outlive the account row.
 */
model BannedEmailHash {
  emailHash  String   @id @map("email_hash")
  reason     String?
  sanctionId String?  @map("sanction_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("banned_email_hashes")
}

/**
 * Created alongside the user in the same signup transaction so the
 * relation is never nullable-in-practice — no endpoint reads/writes this
 * yet (that starts once a settings screen exists, post-P3).
 */
model UserSetting {
  userId            String      @id @map("user_id")
  notificationPrefs Json        @default("{}") @map("notification_prefs")
  pushPreview       PushPreview @default(SENDER_ONLY) @map("push_preview")
  theme             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// --- Phase 4: anonymous identity, profile & privacy settings ---
// (docs/architecture.md §3.2, §8.3 "Persona", §11.6, §28 P4)
//
// V1 columns deliberately NOT here yet: bio, allow_discovery, looking_for,
// skills (§8.4 "Post-MVP tables").

/**
 * Mirrors packages/shared/src/enums.js DmPolicy (§8.3 `anonymous_profiles.dm_policy`).
 */
enum DmPolicy {
  EVERYONE
  NOBODY

  @@map("dm_policy")
}

/**
 * The public persona (§3.2 "PUBLIC PERSONA"). `userId` is unique — one
 * profile per account, ever (renames mutate this row; they never create
 * a new one, so history lives in `ProfileNameHistory` instead).
 * `animal`/`number` are kept alongside the composed `displayName` so a
 * rename can regenerate one without re-parsing the other.
 */
model AnonymousProfile {
  id             String   @id @default(uuid(7))
  userId         String   @unique @map("user_id")
  universityId   String   @map("university_id")
  publicId       String   @unique @map("public_id")
  animal         String
  number         Int
  displayName    String   @map("display_name")
  avatarColor    String   @map("avatar_color")
  departmentId   String?  @map("department_id")
  semester       Int?
  showDepartment Boolean  @default(true) @map("show_department")
  showSemester   Boolean  @default(true) @map("show_semester")
  showInterests  Boolean  @default(true) @map("show_interests")
  dmPolicy       DmPolicy @default(EVERYONE) @map("dm_policy")
  nameChangedAt  DateTime @default(now()) @map("name_changed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  university  University           @relation(fields: [universityId], references: [id], onDelete: Restrict)
  department  Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  interests   ProfileInterest[]
  nameHistory ProfileNameHistory[]

  @@unique([universityId, displayName])
  @@index([universityId])
  @@map("anonymous_profiles")
}

/**
 * Every display name a profile has ever had — **admin only** (§8.3,
 * §11.6 "prevents 'change name after harassment' evasion"). Never joined
 * into anything a presenter reads.
 */
model ProfileNameHistory {
  id          String   @id @default(uuid(7))
  profileId   String   @map("profile_id")
  displayName String   @map("display_name")
  changedAt   DateTime @default(now()) @map("changed_at")

  profile AnonymousProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_name_history")
}

/**
 * Join table: a profile's chosen interests (§8.3 "public if show_interests").
 */
model ProfileInterest {
  profileId  String @map("profile_id")
  interestId String @map("interest_id")

  profile  AnonymousProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest Interest         @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
  @@index([interestId])
  @@map("profile_interests")
}
